#!/bin/bash
# Keep both server processes in one container and deliver termination to both.
set -uo pipefail
cd /rails
if [ "${CAMPFIRE_DIRECT_HTTP:-0}" = "1" ]; then
  if [ -z "${DISABLE_SSL+x}" ] || [ -n "${TLS_DOMAIN:-}" ]; then
    echo "CAMPFIRE_DIRECT_HTTP requires DISABLE_SSL and no TLS_DOMAIN" >&2
    exit 2
  fi
  export TARGET_BIND="${CAMPFIRE_DIRECT_BIND:-0.0.0.0}"
  export TARGET_PORT="${HTTP_PORT:-80}"
  workers=${CAMPFIRE_HTTP_WORKERS:-1}
  case "$workers" in 1|2|4) ;; *)
    echo "CAMPFIRE_HTTP_WORKERS must be 1, 2, or 4" >&2; exit 2 ;; esac
  if [ "$workers" = 1 ]; then
    if [ "${CAMPFIRE_HTTP_DISPATCH:-0}" = "1" ]; then
      echo "CAMPFIRE_HTTP_DISPATCH requires multiple HTTP workers" >&2; exit 2
    fi
    if [ "${CAMPFIRE_CENTRAL_POST_WRITER:-0}" = "1" ]; then
      echo "CAMPFIRE_CENTRAL_POST_WRITER requires multiple HTTP workers" >&2
      exit 2
    fi
    exec /usr/local/bin/campfire server
  fi

  bus_socket=/rails/storage/thruster/cable-bus.sock
  presence_ready=/rails/storage/thruster/presence-ready
  rate_limit_dir=$(mktemp -d /tmp/campfire-rate-limits.XXXXXX)
  export CAMPFIRE_RATE_LIMIT_DIR="$rate_limit_dir"
  rm -f "$presence_ready"
  /usr/local/bin/campfire bus "$bus_socket" &
  broker_pid=$!
  pids=("$broker_pid")
  if [ "${CAMPFIRE_CENTRAL_POST_WRITER:-0}" = "1" ]; then
    export CAMPFIRE_POST_WRITER_SOCKET=/rails/storage/thruster/post-writer.sock
    rm -f "$CAMPFIRE_POST_WRITER_SOCKET"
    /usr/local/bin/campfire post-writer "$CAMPFIRE_POST_WRITER_SOCKET" &
    writer_pid=$!
    writer_ready=0
    for ((attempt=0; attempt<100; attempt++)); do
      if [ -S "$CAMPFIRE_POST_WRITER_SOCKET" ]; then writer_ready=1; break; fi
      if ! kill -0 "$writer_pid" 2>/dev/null; then break; fi
      sleep 0.05
    done
    if [ "$writer_ready" -ne 1 ]; then
      echo "Campfire central POST writer did not start" >&2
      kill -s TERM "$writer_pid" "$broker_pid" 2>/dev/null || true
      wait "$writer_pid" "$broker_pid" 2>/dev/null || true
      exit 1
    fi
    pids+=("$writer_pid")
  fi
  dispatch=${CAMPFIRE_HTTP_DISPATCH:-0}
  if [ "$dispatch" = 1 ]; then
    rm -f /rails/storage/thruster/fd-worker-*.sock
    env -u CAMPFIRE_POST_WRITER_SOCKET \
      CAMPFIRE_DISPATCH_WORKER_SOCKET=/rails/storage/thruster/fd-worker-0.sock \
      CAMPFIRE_CABLE_BUS="$bus_socket" \
      CAMPFIRE_PRESENCE_READY_FILE="$presence_ready" \
      /usr/local/bin/campfire server &
  else
    CAMPFIRE_REUSEPORT=1 CAMPFIRE_CABLE_BUS="$bus_socket" \
      CAMPFIRE_PRESENCE_READY_FILE="$presence_ready" \
      /usr/local/bin/campfire server &
  fi
  first_pid=$!
  pids+=("$first_pid")
  ready=0
  for ((attempt=0; attempt<100; attempt++)); do
    if [ -f "$presence_ready" ]; then ready=1; break; fi
    if ! kill -0 "$broker_pid" 2>/dev/null ||
       ! kill -0 "$first_pid" 2>/dev/null; then break; fi
    sleep 0.05
  done
  if [ "$ready" -ne 1 ]; then
    echo "Campfire first worker did not finish presence reset" >&2
    for pid in "${pids[@]}"; do kill -s TERM "$pid" 2>/dev/null || true; done
    for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null || true; done
    rm -rf "$rate_limit_dir"
    exit 1
  fi
  for ((i=1; i<workers; i++)); do
    if [ "$dispatch" = 1 ]; then
      CAMPFIRE_DISPATCH_WORKER_SOCKET="/rails/storage/thruster/fd-worker-$i.sock" \
        CAMPFIRE_CABLE_BUS="$bus_socket" CAMPFIRE_RESET_PRESENCE=0 \
        /usr/local/bin/campfire server &
    else
      CAMPFIRE_REUSEPORT=1 CAMPFIRE_CABLE_BUS="$bus_socket" \
        CAMPFIRE_RESET_PRESENCE=0 /usr/local/bin/campfire server &
    fi
    pids+=("$!")
  done
  if [ "$dispatch" = 1 ]; then
    dispatch_ready=0
    for ((attempt=0; attempt<100; attempt++)); do
      dispatch_ready=1
      for ((i=0; i<workers; i++)); do
        if [ ! -S "/rails/storage/thruster/fd-worker-$i.sock" ]; then
          dispatch_ready=0; break
        fi
      done
      if [ "$dispatch_ready" -eq 1 ]; then break; fi
      sleep 0.05
    done
    if [ "$dispatch_ready" -ne 1 ]; then
      echo "Campfire HTTP dispatcher workers did not start" >&2
      for pid in "${pids[@]}"; do kill -s TERM "$pid" 2>/dev/null || true; done
      for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null || true; done
      rm -rf "$rate_limit_dir"
      exit 1
    fi
    /usr/local/bin/campfire fd-router /rails/storage/thruster &
    pids+=("$!")
  fi
  received_signal=""
  signal_workers() {
    for pid in "${pids[@]}"; do kill -s TERM "$pid" 2>/dev/null || true; done
  }
  trap 'received_signal=TERM; signal_workers' TERM
  trap 'received_signal=INT; signal_workers' INT
  wait -n "${pids[@]}"
  status=$?
  signal_workers
  for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null || true; done
  rm -rf "$rate_limit_dir"
  if [ -n "$received_signal" ]; then exit 0; fi
  if [ "$status" -eq 0 ]; then status=1; fi
  exit "$status"
fi
/usr/local/bin/campfire server &
app_pid=$!
/usr/local/bin/campfire-front run &
front_pid=$!
received_signal=""

signal_children() {
  kill -s "$1" "$app_pid" "$front_pid" 2>/dev/null || true
}
trap 'received_signal=TERM; signal_children TERM' TERM
trap 'received_signal=INT; signal_children INT' INT

wait -n "$app_pid" "$front_pid"
status=$?
signal_children TERM
wait "$app_pid" 2>/dev/null || true
wait "$front_pid" 2>/dev/null || true
if [ -n "$received_signal" ]; then
  # Docker/ONCE requested this shutdown; both children have finished.
  exit 0
fi
if [ "$status" -eq 0 ]; then
  # A long-running child exiting cleanly is still an unexpected service stop.
  status=1
fi
exit "$status"
