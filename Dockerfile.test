# syntax=docker/dockerfile:1.7
# OCaml 5.5.1 test toolchain. Mount this checkout and the sibling pinned Rust
# fixture checkout at /home/opam/projects, then run Dune from the OCaml tree.
FROM ocaml/opam:ubuntu-24.04-ocaml-5.5@sha256:612f36244a0a6b24e2a3bcdcb8555da8ec21c5cb6a37741b5fc20d3a7c8f1630 AS deps

USER root
RUN apt-get update -qq && apt-get install --no-install-recommends -y \
    build-essential pkg-config libsqlite3-dev libssl-dev libcurl4-openssl-dev \
    libqrencode4 zlib1g-dev libgmp-dev libcrypt-dev python3 \
    python3-cryptography libvips42t64 ffmpeg && \
    rm -rf /var/lib/apt/lists/*
USER opam
RUN opam install -y --jobs=4 \
    dune.3.24.2 sqlite3 uri ipaddr yojson.2.2.2 base64 astring ocplib-endian \
    conduit.6.2.3 conduit-lwt-unix.6.2.3 \
    mirage-crypto.0.11.3 mirage-crypto-rng.0.11.3 \
    cstruct pbkdf.1.2.0 eqaf ptime uutf \
    cohttp.5.3.0 cohttp-lwt.5.3.0 cohttp-lwt-unix.5.3.0 \
    ssl lwt logs fmt cmdliner tyxml alcotest
RUN opam install -y lwt_ssl.1.2.0 && \
    opam reinstall -y conduit-lwt-unix.6.2.3
