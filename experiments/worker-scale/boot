#!/bin/bash
# Diagnostic only: measure independent request loops before adding cross-worker
# Cable and job coordination. Do not use this boot script for deployment.
set -uo pipefail
cd /rails

workers=${CAMPFIRE_WORKERS:-1}
case "$workers" in 1|2|4) ;; *) echo "CAMPFIRE_WORKERS must be 1, 2, or 4" >&2; exit 2 ;; esac
target_port=${THRUSTER_TARGET_PORT:-${TARGET_PORT:-3000}}
case "$target_port" in *[!0-9]*|'') echo "invalid target port" >&2; exit 2 ;; esac

upstreams=""
pids=()
for ((i=0; i<workers; i++)); do
  port=$((target_port + i))
  upstreams="${upstreams} 127.0.0.1:${port}"
  /usr/local/bin/campfire serve --port "$port" &
  pids+=("$!")
done

mkdir -p /rails/storage/thruster/caddy
config=/rails/storage/thruster/caddy/Caddyfile
/usr/local/bin/campfire-front config > "$config"
sed -i "s/reverse_proxy [^ ]* {/reverse_proxy${upstreams} {/" "$config"
caddy run --config "$config" --adapter caddyfile &
pids+=("$!")

signal_children() {
  for pid in "${pids[@]}"; do kill -s TERM "$pid" 2>/dev/null || true; done
}
trap signal_children TERM INT
wait -n "${pids[@]}"
status=$?
signal_children
for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null || true; done
if [ "$status" -eq 0 ]; then status=1; fi
exit "$status"
